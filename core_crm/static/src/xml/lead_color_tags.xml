<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="core_crm.LeadColorTag">
        <span
            class="o_tag position-relative d-inline-flex align-items-center user-select-none mw-100 o_badge badge rounded-pill"
            t-att-style="`background-color: ${this.props.hexColor}; color: #FFFFFF;`"
            t-att-data-tooltip="this.props.tooltip or this.props.text"
        >
            <div class="o_tag_badge_text o_badge_text" t-out="this.props.text"/>
            <t t-if="this.props.onDelete">
                <a
                    class="o_delete ps-1 opacity-75 opacity-100-hover"
                    href="#"
                    tabindex="-1"
                    t-att-aria-label="this.props.crossTooltip"
                    t-att-data-tooltip="this.props.crossTooltip"
                    t-on-click.stop.prevent="() => this.props.onDelete()"
                >
                    <i class="oi" data-icon="close_small"/>
                </a>
            </t>
        </span>
    </t>
</templates>
